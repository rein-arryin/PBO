<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jasadesign.controller.FormPesananController"
      spacing="6" styleClass="content-area">

    <Label text="Pesanan Baru" styleClass="title"/>

    <Label text="JUDUL" styleClass="form-label"><padding><Insets top="10"/></padding></Label>
    <TextField fx:id="titleField"/>

    <Label text="JENIS DESAIN" styleClass="form-label"><padding><Insets top="6"/></padding></Label>
    <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>

    <Label text="DESKRIPSI" styleClass="form-label"><padding><Insets top="6"/></padding></Label>
    <TextArea fx:id="descArea" prefRowCount="4" wrapText="true"/>

    <HBox spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="WARNA" styleClass="form-label"><padding><Insets top="6"/></padding></Label>
            <TextField fx:id="colorField"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="UKURAN" styleClass="form-label"><padding><Insets top="6"/></padding></Label>
            <TextField fx:id="sizeField" promptText="mis. 1080x1080"/>
        </VBox>
    </HBox>

    <Label text="LINK REFERENSI" styleClass="form-label"><padding><Insets top="6"/></padding></Label>
    <TextField fx:id="refField"/>

    <Label text="DEADLINE" styleClass="form-label"><padding><Insets top="6"/></padding></Label>
    <DatePicker fx:id="deadlinePicker" maxWidth="Infinity"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="16"/></padding>
        <Button text="Batal" onAction="#handleCancel" styleClass="secondary-button"/>
        <Button text="Simpan" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>
</VBox>