<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jasadesign.controller.PemesanController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
            <Label text="Jasa Desain" styleClass="app-name"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="user-label"/>
            <Button text="Keluar" onAction="#handleLogout" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18" styleClass="content-area">
            <HBox spacing="12">
                <VBox styleClass="stat-card">
                    <Label fx:id="totalLabel" styleClass="stat-value"/>
                    <Label text="Total pesanan" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label fx:id="menungguLabel" styleClass="stat-value"/>
                    <Label text="Menunggu" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label fx:id="diprosesLabel" styleClass="stat-value"/>
                    <Label text="Diproses" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label fx:id="selesaiLabel" styleClass="stat-value"/>
                    <Label text="Selesai" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <Label text="Pesanan Saya" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Pesanan Baru" onAction="#handleNew" styleClass="primary-button"/>
            </HBox>

            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="No" maxWidth="60"/>
                    <TableColumn fx:id="colTitle" text="Judul"/>
                    <TableColumn fx:id="colType" text="Jenis"/>
                    <TableColumn fx:id="colDeadline" text="Deadline"/>
                    <TableColumn fx:id="colStatus" text="Status"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>