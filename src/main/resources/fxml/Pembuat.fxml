<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jasadesign.controller.PembuatController"
            stylesheets="@../css/style.css">

    <left>
        <VBox styleClass="sidebar" spacing="18">
            <VBox spacing="5">
                <Label text="JASA DESAIN" styleClass="sidebar-title"/>
                <Label text="Panel Pembuat" styleClass="sidebar-subtitle"/>
            </VBox>

            <Separator opacity="0.3"/>

            <Button text="Dashboard" styleClass="menu-button"/>
            <Button text="Pesanan Masuk" styleClass="menu-button"/>
            <Button text="Pesanan Diproses" styleClass="menu-button"/>
            <Button text="Pesanan Selesai" styleClass="menu-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    styleClass="logout-button"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="22" style="-fx-padding: 30px;">

            <VBox spacing="5">
                <Label text="Dashboard Pembuat" styleClass="page-title"/>
                <Label text="Kelola dan pantau permintaan desain dari pemesan."
                       styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="15">
                <VBox styleClass="stat-card" spacing="10">
                    <Label text="Pesanan Masuk" styleClass="stat-label"/>
                    <Label text="0" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="10">
                    <Label text="Sedang Dikerjakan" styleClass="stat-label"/>
                    <Label text="0" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="10">
                    <Label text="Pesanan Selesai" styleClass="stat-label"/>
                    <Label text="0" styleClass="stat-value"/>
                </VBox>
            </HBox>

            <VBox styleClass="content-card" spacing="15">
                <VBox spacing="4">
                    <Label text="Daftar Pesanan Masuk"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label text="Pilih pesanan untuk melihat detail dan mengubah status."
                           styleClass="page-subtitle"/>
                </VBox>

                <TableView VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Belum ada pesanan masuk."/>
                    </placeholder>
                    <columns>
                        <TableColumn text="ID" prefWidth="55"/>
                        <TableColumn text="Pemesan" prefWidth="130"/>
                        <TableColumn text="Nama Pesanan" prefWidth="170"/>
                        <TableColumn text="Jenis Desain" prefWidth="130"/>
                        <TableColumn text="Deadline" prefWidth="110"/>
                        <TableColumn text="Status" prefWidth="120"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Lihat Detail" styleClass="primary-button"/>
                    <Button text="Ubah Status"
                            style="-fx-background-color: #E9A23B; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 10 16;"/>
                </HBox>
            </VBox>

        </VBox>
    </center>
</BorderPane>

